#!/bin/zsh
set -euo pipefail

root_dir="$(git rev-parse --show-toplevel)"
should_build=0

while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/tags/v*) should_build=1 ;;
    esac
done

if [[ "$should_build" == "0" ]]; then
    exit 0
fi

print "正在生成本地 Codex Switcher.app…"
"$root_dir/scripts/build-app.sh"
print "本地应用已更新：$root_dir/dist/Codex Switcher.app"
